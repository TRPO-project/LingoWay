PORT=8080

# База данных: эти значения использует docker-compose для контейнера Postgres
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=lingoway

# Для запуска бэкенда у себя через go run (БД в контейнере, порт проброшен на localhost)
DATABASE_URL=postgres://postgres:password@localhost:5432/lingoway

LLM_API_KEYS=key1,key2,key3
JWT_SECRET=change-me