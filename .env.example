PORT=8080

DB_USER=postgres
DB_PASSWORD=password
DB_NAME=lingoway

# Для запуска бэкенда у себя через go run (БД в контейнере, порт проброшен на localhost)
DATABASE_URL=postgres://postgres:password@localhost:5432/lingoway

# Применять модели GORM и ограничения PostgreSQL перед запуском HTTP.
DB_AUTO_MIGRATE=true
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONNECT_TIMEOUT=5s
DB_MIGRATION_TIMEOUT=1m

# Без ключей подготовка через LLM отключена; предварительный импорт текста остаётся доступен.
# Несколько ключей одного сервиса указываются через запятую и используются по очереди.
LLM_API_KEYS=
# Базовый адрес API без /chat/completions: этот путь клиент добавит сам.
LLM_BASE_URL=https://api.openai.com/v1
# Имя модели у выбранного провайдера. Она должна поддерживать Chat Completions и JSON mode.
LLM_MODEL=gpt-4o-mini
# Время одного обращения к модели; формат Go duration: 45s, 1m и т. п.
LLM_TIMEOUT=45s
# Пауза между проверками пустой очереди, а не интервал опроса статуса с фронтенда.
LLM_POLL_INTERVAL=1s
# Общее число попыток для одного запроса, включая первую; допустимо от 1 до 10.
LLM_MAX_ATTEMPTS=3
