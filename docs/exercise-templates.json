{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Шаблоны заданий LingoWay v0.2",
  "description": "Полный внутренний формат задания. answer_key и explanation приватны.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "vocabulary_gap",
        "vocabulary_matching_translation",
        "vocabulary_matching_definition",
        "vocabulary_context_choice",
        "grammar_brackets",
        "grammar_tense",
        "grammar_word_order",
        "comprehension_question",
        "reasoning_question"
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "question_text": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object"
    },
    "answer_key": {
      "type": "object"
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "type",
    "instruction",
    "question_text",
    "content",
    "answer_key",
    "explanation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "vocabulary_gap",
              "vocabulary_context_choice",
              "grammar_brackets",
              "grammar_tense"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/ChoiceContent"
          },
          "answer_key": {
            "$ref": "#/$defs/ChoiceKey"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "vocabulary_matching_translation",
              "vocabulary_matching_definition"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/MatchingContent"
          },
          "answer_key": {
            "$ref": "#/$defs/MatchingKey"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "grammar_word_order"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/WordOrderContent"
          },
          "answer_key": {
            "$ref": "#/$defs/WordOrderKey"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "comprehension_question",
              "reasoning_question"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/FreeTextContent"
          },
          "answer_key": {
            "$ref": "#/$defs/FreeTextKey"
          }
        }
      }
    }
  ],
  "$defs": {
    "Item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "ChoiceContent": {
      "type": "object",
      "properties": {
        "format": {
          "const": "single_choice"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "format",
        "options"
      ],
      "additionalProperties": false
    },
    "MatchingContent": {
      "type": "object",
      "properties": {
        "format": {
          "const": "matching"
        },
        "left_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "minItems": 4,
          "maxItems": 6
        },
        "right_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "minItems": 4,
          "maxItems": 6
        }
      },
      "required": [
        "format",
        "left_items",
        "right_items"
      ],
      "additionalProperties": false
    },
    "WordOrderContent": {
      "type": "object",
      "properties": {
        "format": {
          "const": "word_order"
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "target_language": {
          "const": "en"
        },
        "word_bank": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "minItems": 2,
          "maxItems": 40
        }
      },
      "required": [
        "format",
        "source_text",
        "target_language",
        "word_bank"
      ],
      "additionalProperties": false
    },
    "FreeTextContent": {
      "type": "object",
      "properties": {
        "format": {
          "const": "free_text"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "format",
        "context"
      ],
      "additionalProperties": false
    },
    "Pair": {
      "type": "object",
      "properties": {
        "left_id": {
          "type": "string",
          "minLength": 1
        },
        "right_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "left_id",
        "right_id"
      ],
      "additionalProperties": false
    },
    "ChoiceKey": {
      "type": "object",
      "properties": {
        "correct_choice_id": {
          "type": "string",
          "minLength": 1
        },
        "distractor_types": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "correct_choice_id"
      ],
      "additionalProperties": false
    },
    "MatchingKey": {
      "type": "object",
      "properties": {
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pair"
          },
          "minItems": 4,
          "maxItems": 6
        }
      },
      "required": [
        "pairs"
      ],
      "additionalProperties": false
    },
    "WordOrderKey": {
      "type": "object",
      "properties": {
        "token_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 40,
          "uniqueItems": true
        },
        "correct_translation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "token_ids"
      ],
      "additionalProperties": false
    },
    "FreeTextKey": {
      "type": "object",
      "properties": {
        "rubric": {
          "type": "object",
          "properties": {
            "criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 10
            },
            "reference_answer": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "criteria"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "rubric"
      ],
      "additionalProperties": false
    },
    "ChoiceResponse": {
      "type": "object",
      "properties": {
        "format": {
          "const": "single_choice"
        },
        "choice_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "choice_id"
      ],
      "additionalProperties": false
    },
    "MatchingResponse": {
      "type": "object",
      "properties": {
        "format": {
          "const": "matching"
        },
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pair"
          },
          "minItems": 4,
          "maxItems": 6
        }
      },
      "required": [
        "format",
        "pairs"
      ],
      "additionalProperties": false
    },
    "WordOrderResponse": {
      "type": "object",
      "properties": {
        "format": {
          "const": "word_order"
        },
        "token_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 40,
          "uniqueItems": true
        }
      },
      "required": [
        "format",
        "token_ids"
      ],
      "additionalProperties": false
    },
    "FreeTextResponse": {
      "type": "object",
      "properties": {
        "format": {
          "const": "free_text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      },
      "required": [
        "format",
        "text"
      ],
      "additionalProperties": false
    }
  },
